DATABASE_URL=postgresql://pulsepath:pulsepath@localhost:5432/pulsepath
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=a1b2c3d4e5f6789012345678abcdef0123456789abcdef0123456789abcdef01
ADMIN_SECRET=change-me
NODE_ENV=development
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@study.pulsepath.local

# Ops alerts (optional webhook URL)
ALERT_WEBHOOK_URL=

# Cron interno (Vercel Cron / jobs)
CRON_SECRET=change-me-cron

# Desactivar PDF/Puppeteer (1 en Vercel temporal)
DISABLE_PDF=0

# Deploy metadata
GIT_SHA=dev
