// PulsePath — PostgreSQL schema (piloto B2B + estudio ML)
// Índices cifrados (BYTEA); nunca datos biométricos crudos ni PII de empleados.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StudyTimepoint {
  D0
  D7
  D14
}

enum QuestionnaireInstrument {
  DASS21_STRESS
  DASS21_FULL
  GAD7
  CBI
}

model Organization {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  slug            String    @unique
  pilotRef        String?   @map("pilot_ref")
  kind            String    @default("b2b")
  studyStartsAt   DateTime? @map("study_starts_at") @db.Date
  studyEndsAt     DateTime? @map("study_ends_at") @db.Date
  protocolVersion String?   @map("protocol_version")
  targetN         Int?      @map("target_n")
  codePoolSize    Int?      @map("code_pool_size")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  retentionUntil  DateTime  @map("retention_until") @db.Date

  accessCodes                AccessCode[]
  sessions                   Session[]
  employerUsers              EmployerUser[]
  dailyCheckins              DailyCheckin[]
  questionnaireSubmissions   QuestionnaireSubmission[]
  pushSubscriptions          PushSubscription[]
  ingestAuditLogs            IngestAuditLog[]

  @@map("organizations")
}

model AccessCode {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  codeHash    String    @unique @map("code_hash")
  department  String?
  shift       String?
  gender      String?
  ageBand     String?   @map("age_band")
  tenureBand  String?   @map("tenure_band")
  slotLabel   String?   @map("slot_label")
  studyDay0   DateTime? @map("study_day0") @db.Date
  profileEnc  Bytes?    @map("profile_enc")
  activatedAt DateTime? @map("activated_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revoked     Boolean   @default(false)

  organization             Organization              @relation(fields: [orgId], references: [id])
  sessions                 Session[]
  consent                  Consent?
  dailyCheckins            DailyCheckin[]
  questionnaireSubmissions QuestionnaireSubmission[]
  pushSubscriptions        PushSubscription[]

  @@index([orgId])
  @@map("access_codes")
}

model Session {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  codeHash       String   @map("code_hash")
  department     String?
  shift          String?
  gender         String?
  ageBand        String?  @map("age_band")
  tenureBand     String?  @map("tenure_band")
  takenAt        DateTime @map("taken_at") @db.Timestamptz(6)
  riskIndexEnc   Bytes    @map("risk_index_enc")
  pvtIndexEnc    Bytes    @map("pvt_index_enc")
  stroopIndexEnc Bytes    @map("stroop_index_enc")
  cbiScoreEnc    Bytes?   @map("cbi_score_enc")
  sleepHoursEnc  Bytes    @map("sleep_hours_enc")

  organization Organization @relation(fields: [orgId], references: [id])
  accessCode   AccessCode   @relation(fields: [codeHash], references: [codeHash])

  @@index([orgId])
  @@index([codeHash])
  @@index([department])
  @@index([takenAt])
  @@map("sessions")
}

model DailyCheckin {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  codeHash       String   @map("code_hash")
  dateLocal      DateTime @map("date_local") @db.Date
  tz             String
  takenAt        DateTime @map("taken_at") @db.Timestamptz(6)
  clientRecordId String   @map("client_record_id")
  payloadEnc     Bytes    @map("payload_enc")
  payloadSha256  String   @map("payload_sha256")
  appVersion     String?  @map("app_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])
  accessCode   AccessCode   @relation(fields: [codeHash], references: [codeHash])

  @@unique([codeHash, dateLocal])
  @@unique([codeHash, clientRecordId])
  @@index([orgId, dateLocal])
  @@map("daily_checkins")
}

model QuestionnaireSubmission {
  id              String                  @id @default(uuid()) @db.Uuid
  orgId           String                  @map("org_id") @db.Uuid
  codeHash        String                  @map("code_hash")
  instrument      QuestionnaireInstrument
  timepoint       StudyTimepoint
  takenAt         DateTime                @map("taken_at") @db.Timestamptz(6)
  clientRecordId  String                  @map("client_record_id")
  responsesEnc    Bytes                   @map("responses_enc")
  responsesSha256 String                  @map("responses_sha256")
  schemaVersion   String                  @map("schema_version")
  appVersion      String?                 @map("app_version")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])
  accessCode   AccessCode   @relation(fields: [codeHash], references: [codeHash])

  @@unique([codeHash, instrument, timepoint])
  @@unique([codeHash, clientRecordId])
  @@index([orgId, timepoint])
  @@map("questionnaire_submissions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  codeHash  String   @map("code_hash")
  endpoint  String
  p256dh    String
  auth      String
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])
  accessCode   AccessCode   @relation(fields: [codeHash], references: [codeHash])

  @@unique([codeHash, endpoint])
  @@index([orgId])
  @@map("push_subscriptions")
}

model IngestAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  codeHash  String?  @map("code_hash")
  route     String
  status    Int
  clientId  String?  @map("client_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@map("ingest_audit_logs")
}

model EmployerUser {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("viewer")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("employer_users")
}

model Consent {
  id            String   @id @default(uuid()) @db.Uuid
  codeHash      String   @unique @map("code_hash")
  consentedAt   DateTime @map("consented_at") @db.Timestamptz(6)
  policyVersion String   @map("policy_version")

  accessCode AccessCode @relation(fields: [codeHash], references: [codeHash])

  @@index([codeHash])
  @@map("consents")
}
